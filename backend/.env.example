# ==============================================================================
# CrimeLens Forensic & Intelligence Platform - Environment Template
# Copy this file to .env: cp .env.example .env
# ==============================================================================

# Server Settings
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Security & Authentication
JWT_SECRET=your_jwt_secret_key_here
SECURITY_CLEARANCE_LEVEL=LEVEL_4_RESTRICTED

# Database Connection
DATABASE_URL=mongodb://localhost:27017/crimelens
DB_NAME=crimelens_forensic_db

# CrimeLens Intelligence & Neural Engine Keys
CRIMELENS_API_KEY=your_crimelens_api_key_here
NEURAL_ENGINE_API_KEY=your_neural_engine_api_key_here

# Google Gemini / LLM Integration (Replace with your Google AI Studio key if using live Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# External Intelligence & Telemetry Feeds
SIGINT_GATEWAY_URL=https://gateway.crimelens.intel.internal
C2_DETECTION_ENABLED=true
